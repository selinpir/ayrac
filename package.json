{
  "name": "ayrac",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A local-first Chrome side panel for parking tabs and picking up where you left off.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node tests/extension.e2e.mjs",
    "test:ui": "node tests/ui.smoke.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.32",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "playwright": "^1.58.0",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
